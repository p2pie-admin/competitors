{
  "name": "competitors",
  "version": "1.0.0",
  "description": "Collects data from competing exchanger monitorings (BestChange first): exchanger stats, review counts, review texts with source attribution. Feeds p2pie.com.",
  "license": "UNLICENSED",
  "private": true,
  "main": "build/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rimraf ./build && tsc -p tsconfig.build.json",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit",
    "test": "LOG_LEVEL=error node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fflate": "^0.8.2",
    "robots-parser": "^3.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "rimraf": "^5.0.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}

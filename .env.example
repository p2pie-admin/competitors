# Admin API token (Bearer). Generate: openssl rand -hex 32. Without it /admin/* answers 503.
COMPETITORS_ADMIN_TOKEN=
COMPETITORS_PORT=5100
OUR_SERVER_URL=http://server:5000
CONTACT_EMAIL=support@p2pie.com
CONTACT_URL=https://p2pie.com
# false = collect and count, but the public API returns no review texts
PUBLISH_REVIEW_TEXTS=true
BESTCHANGE_ENABLED=true
LOG_LEVEL=info
